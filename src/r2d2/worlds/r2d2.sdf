<?xml version="1.0"?>
<sdf version="1.9">
  <world name="r2d2_world">

    <!-- ===================================================== -->
    <!-- r2d2                                               -->
    <!-- ===================================================== -->

    <r2d2 name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </r2d2>

    <plugin filename="gz-sim-r2d2-system"
            name="gz::sim::systems::r2d2"/>

    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>

    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>

    <!-- Required for GPU LiDAR and camera -->
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <gravity>0 0 -9.8</gravity>


    <!-- ===================================================== -->
    <!-- LIGHTING                                              -->
    <!-- ===================================================== -->

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>

      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>

      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>

      <direction>-0.5 0.1 -0.9</direction>
    </light>


    <!-- ===================================================== -->
    <!-- GROUND PLANE                                          -->
    <!-- ===================================================== -->

    <model name="ground_plane">
      <static>true</static>

      <link name="link">

        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>

          <material>
            <ambient>0.58 0.58 0.58 1</ambient>
            <diffuse>0.68 0.68 0.68 1</diffuse>
          </material>
        </visual>

      </link>
    </model>


    <!-- ===================================================== -->
    <!-- ARENA PERIMETER                                       -->
    <!-- Arena dimensions: 8 m x 8 m                           -->
    <!-- Wall height: 0.35 m                                   -->
    <!-- ===================================================== -->

    <!-- BACK WALL: retained from the original world -->
    <model name="wall_back">
      <static>true</static>
      <pose>0 -4.0 0.175 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>8 0.1 2.00</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>8 0.1 2.00</size>
            </box>
          </geometry>

          <material>
            <ambient>0.95 0.40 0.08 1</ambient>
            <diffuse>0.95 0.40 0.08 1</diffuse>
          </material>
        </visual>

      </link>
    </model>


    <!-- LEFT WALL: retained from the original world -->
    <model name="wall_left">
      <static>true</static>
      <pose>-4.0 0 0.175 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>0.1 8 2.00</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 8 2.00</size>
            </box>
          </geometry>

          <material>
            <ambient>0.95 0.40 0.08 1</ambient>
            <diffuse>0.95 0.40 0.08 1</diffuse>
          </material>
        </visual>

      </link>
    </model>


    <!-- RIGHT WALL: new -->
    <model name="wall_right">
      <static>true</static>
      <pose>4.0 0 0.175 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>0.1 8 2.00</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 8 2.00</size>
            </box>
          </geometry>

          <material>
            <ambient>0.95 0.40 0.08 1</ambient>
            <diffuse>0.95 0.40 0.08 1</diffuse>
          </material>
        </visual>

      </link>
    </model>


    <!-- FRONT WALL: new -->
    <model name="wall_front">
      <static>true</static>
      <pose>0 4.0 0.175 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>8 0.1 2.00</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>8 0.1 2.00</size>
            </box>
          </geometry>

          <material>
            <ambient>0.95 0.40 0.08 1</ambient>
            <diffuse>0.95 0.40 0.08 1</diffuse>
          </material>
        </visual>

      </link>
    </model>


    <!-- ===================================================== -->
    <!-- ORIGINAL OBJECT 1: BOX                                -->
    <!-- Original position and dimensions retained             -->
    <!-- ===================================================== -->

    <model name="box_1">
      <static>true</static>
      <pose>1.39 1.62 1.0 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>1 1 2</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>1 1 2</size>
            </box>
          </geometry>

          <material>
            <ambient>0.8 0.2 0.2 1</ambient>
            <diffuse>0.8 0.2 0.2 1</diffuse>
          </material>
        </visual>

      </link>
    </model>


    <!-- ===================================================== -->
    <!-- ORIGINAL OBJECT 2: CYLINDER 1                         -->
    <!-- Original position and dimensions retained             -->
    <!-- ===================================================== -->

    <model name="cylinder_1">
      <static>true</static>
      <pose>-2.0 -2.0 1.0 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.4</radius>
              <length>2</length>
            </cylinder>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.4</radius>
              <length>2</length>
            </cylinder>
          </geometry>

          <material>
            <ambient>0.2 0.7 0.2 1</ambient>
            <diffuse>0.2 0.7 0.2 1</diffuse>
          </material>
        </visual>

      </link>
    </model>


    <!-- ===================================================== -->
    <!-- ORIGINAL OBJECT 3: CYLINDER 2                         -->
    <!-- Original position and dimensions retained             -->
    <!-- ===================================================== -->

    <model name="cylinder_2">
      <static>true</static>
      <pose>3.0 -1.5 1.0 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.5</radius>
              <length>2</length>
            </cylinder>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.5</radius>
              <length>2</length>
            </cylinder>
          </geometry>

          <material>
            <ambient>0.9 0.7 0.1 1</ambient>
            <diffuse>0.9 0.7 0.1 1</diffuse>
          </material>
        </visual>

      </link>
    </model>


    <!-- ===================================================== -->
    <!-- ADDITIONAL INTERIOR OBSTACLES                         -->
    <!-- Low rectangular blocks inspired by the reference      -->
    <!-- ===================================================== -->

    <!-- Obstacle 1: central-left block -->
    <model name="obstacle_1">
      <static>true</static>
      <pose>-3.41 1.38 0.25 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>1.5 0.35 2.0</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>1.5 0.35 2.0</size>
            </box>
          </geometry>

          <material>
            <ambient>0.32 0.20 0.12 1</ambient>
            <diffuse>0.42 0.27 0.16 1</diffuse>
          </material>
        </visual>

      </link>
    </model>


    <!-- Obstacle 2: central-right block -->
    <model name="obstacle_2">
      <static>true</static>
      <pose>-1.45 3.51 0.3 0 0 1.58</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>0.9 0.4 2.0</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.9 0.4 2.0</size>
            </box>
          </geometry>

          <material>
            <ambient>0.35 0.22 0.13 1</ambient>
            <diffuse>0.45 0.29 0.17 1</diffuse>
          </material>
        </visual>

      </link>
    </model>


    <!-- Obstacle 3: rear-left block -->
    <model name="obstacle_3">
      <static>true</static>
      <pose>-3.46 -1.2 0.2 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>1.0 0.35 2.0</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>1.0 0.35 2.0</size>
            </box>
          </geometry>

          <material>
            <ambient>0.32 0.20 0.12 1</ambient>
            <diffuse>0.42 0.27 0.16 1</diffuse>
          </material>
        </visual>

      </link>
    </model>


    <!-- Obstacle 4: rear-right block -->
    <model name="obstacle_4">
      <static>true</static>
      <pose>2.07 -1.49 0.19 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>1.1 0.4 2.0</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>1.1 0.4 0.5</size>
            </box>
          </geometry>

          <material>
            <ambient>0.35 0.22 0.13 1</ambient>
            <diffuse>0.45 0.29 0.17 1</diffuse>
          </material>
        </visual>

      </link>
    </model>


    <!-- Obstacle 5: front-side block
    <model name="obstacle_5">
      <static>true</static>
      <pose>2.7 2.0 0.2 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>0.8 0.35 0.4</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.8 0.35 0.4</size>
            </box>
          </geometry>

          <material>
            <ambient>0.32 0.20 0.12 1</ambient>
            <diffuse>0.42 0.27 0.16 1</diffuse>
          </material>
        </visual>

      </link>
    </model> -->


    <!-- Obstacle 6: front-left block -->
    <model name="obstacle_6">
      <static>true</static>
      <pose>-1.2 -3.58 0.2 0 0 -1.54</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>1.8 0.35 2.0</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>1.8 0.35 2.0</size>
            </box>
          </geometry>

          <material>
            <ambient>0.35 0.22 0.13 1</ambient>
            <diffuse>0.45 0.29 0.17 1</diffuse>
          </material>
        </visual>

      </link>
    </model>


  </world>
</sdf>